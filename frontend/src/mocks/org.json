  "services": [
    {
      "id": "idp",
      "name": "Identity Provider (SSO)",
      "kind": "identity_provider",
      "sensitivity": "high",
      "description": "Single sign-on for every company account. One password opens everything connected to it."
    },
    {
      "id": "mail",
      "name": "Company Email",
      "kind": "email",
      "sensitivity": "high",
      "description": "Mailboxes and the internal address book. A taken-over mailbox can send convincing phishing to colleagues."
    },
    {
      "id": "files",
      "name": "File Storage",
      "kind": "file_storage",
      "sensitivity": "high",
      "description": "Shared drives for all departments."
    },
    {
      "id": "erp",
      "name": "Finance ERP",
      "kind": "internal_app",
      "sensitivity": "high",
      "description": "Invoices, supplier records and payment runs."
    },
    {
      "id": "crm",
      "name": "CRM",
      "kind": "internal_app",
      "sensitivity": "medium",
      "description": "Customer accounts, deals and contact history."
    },
    {
      "id": "hr_portal",
      "name": "HR Portal",
      "kind": "internal_app",
      "sensitivity": "high",
      "description": "Employee records, contracts and payroll."
    },
    {
      "id": "tms",
      "name": "Fleet & Dispatch",
      "kind": "internal_app",
      "sensitivity": "medium",
      "description": "Shipments, routes and driver schedules."
    },
    {
      "id": "admin_console",
      "name": "Admin Console",
      "kind": "internal_app",
      "sensitivity": "high",
      "description": "Manages user accounts, MFA and SSO settings."
    },
    {
      "id": "invoices_data",
      "name": "Supplier bank details & invoices",
      "kind": "data",
      "sensitivity": "high",
      "description": "Bank account numbers used for supplier payments."
    },
    {
      "id": "contracts_data",
      "name": "Customer contracts",
      "kind": "data",
      "sensitivity": "high",
      "description": "Signed contracts and pricing on the shared drive."
    },
    {
      "id": "customer_data",
      "name": "Customer contact list",
      "kind": "data",
      "sensitivity": "medium",
      "description": "Names, emails and phone numbers of customers."
    },
    {
      "id": "payroll_data",
      "name": "Payroll records",
      "kind": "data",
      "sensitivity": "high",
      "description": "Salaries, national ID numbers and bank details of employees."
    },
    {
      "id": "shipment_data",
      "name": "Shipment schedules",
      "kind": "data",
      "sensitivity": "medium",
      "description": "Planned routes and high-value cargo times."
    }
  ],
